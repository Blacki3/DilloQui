# Variabili d'ambiente richieste
# Copia questo file in .env.local e inserisci i tuoi valori.
# .env.local non viene mai versionato.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Chiave pubblica VAPID per le Web Push. Opzionale: senza di essa l'app
# funziona, ma il pulsante «attiva notifiche» risponde che manca la chiave.
# Genera la coppia con:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ------------------------------------------------------------
# NON vanno in questo file: sono segreti del server e si impostano
# sulla Edge Function, dove il browser non può leggerli.
#
#   npx supabase secrets set VAPID_PUBLIC_KEY=...
#   npx supabase secrets set VAPID_PRIVATE_KEY=...
#   npx supabase secrets set VAPID_SUBJECT=mailto:tua@email.it
# ------------------------------------------------------------
